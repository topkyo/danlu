# Copy to `.env` (gitignored) or export in your shell.
# Deterministic paths (new-vault / compile / today / lint) work with no keys.
# Ask and the default universal `drop` planner need a key for the selected backend.

# Default product route. Omit to keep deepseek-api + deepseek-v4-flash.
# AIWIKI_LLM_BACKEND=deepseek-api
# AIWIKI_LLM_MODEL=deepseek-v4-flash
AIWIKI_DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY=

# Escape hatches (set AIWIKI_LLM_BACKEND explicitly; no silent fallback).
# AIWIKI_LLM_BACKEND=openai-api
# AIWIKI_LLM_API_KEY=
# OPENAI_API_KEY=

# AIWIKI_LLM_BACKEND=anthropic-api
# AIWIKI_ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY=

# AIWIKI_LLM_BACKEND=opencode-api
# AIWIKI_OPENCODE_API_KEY=

# Optional: turn off LLM planner / distill while keeping compile.
# AIWIKI_LLM_PLANNER=0
# AIWIKI_LLM_DISTILL=0
