[Unit]
Description=aiwiki inbox watcher
After=default.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__ENV_FILE__
Environment=PYTHONPATH=__PROJECT_ROOT__/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__PROJECT_ROOT__/scripts/run_watch.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__VAULT__
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
