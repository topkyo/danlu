# Project-local reviewer capability hints for automatic qa-review mode resolution.
# Set each capability to yes or no. The resolver picks the first enabled mode in
# REVIEW_MODE_PREFERENCE.

REVIEW_CAPABILITY_ISOLATED_AGENT=no
REVIEW_CAPABILITY_EXTERNAL_AGENT=no
REVIEW_CAPABILITY_FRESH_SESSION=no
REVIEW_CAPABILITY_SAME_CONTEXT=yes
REVIEW_CAPABILITY_HUMAN=no

# Ordered fallback chain.
REVIEW_MODE_PREFERENCE=isolated-agent,external-agent,fresh-session,same-context,human

# Optional defaults written when qa-review mode is auto-resolved.
REVIEWER_SCOPE_DEFAULT=contract+diff+touched-files
REVIEWER_IDENTITY_DEFAULT=
REVIEW_MODEL_PREFERENCE_DEFAULT="claude-opus-4-6 -> gpt-5.4 fallback"
SAME_CONTEXT_FALLBACK_REASON_DEFAULT="isolated reviewer capability not configured in .codex/review-capabilities.env"

# Optional qa-review launcher hooks.
# Default strongest-model fallback when Claude Opus 4.6 is unavailable in the
# current review path.
REVIEW_HANDOFF_DIR_DEFAULT=".codex/review-handoffs"
REVIEW_OUTPUT_FILE_DEFAULT=".codex/review-handoffs/qa-review.output.md"
REVIEW_LAUNCH_COMMAND_ISOLATED_AGENT=""
REVIEW_LAUNCH_COMMAND_EXTERNAL_AGENT=""
REVIEW_LAUNCH_COMMAND_FRESH_SESSION='codex review -c model="gpt-5.4" --uncommitted - < "$OPEN_HARNESS_REVIEW_HANDOFF_FILE" > "$OPEN_HARNESS_REVIEW_OUTPUT_FILE"'
REVIEW_LAUNCH_COMMAND_SAME_CONTEXT=""
REVIEW_LAUNCH_COMMAND_HUMAN=""
