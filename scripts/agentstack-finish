#!/usr/bin/env bash
set -euo pipefail

default_run_id() {
  printf '%s-%s\n' "$(date +%Y%m%d%H%M%S)" "$$"
}

run_id="${AGENTSTACK_RUN_ID:-$(default_run_id)}"
out_dir=".agentstack/evidence/$run_id"
mkdir -p "$out_dir"
summary="$out_dir/summary.md"

usage() {
  cat <<'USAGE'
Usage: agentstack-finish [--risk-level L0|L1|L2|L3|L4|L5] [--context PATH] [--runtime-evidence PATH] [--pre-submit-review-required]

Write an AgentStack finish summary with same-run evidence preferred.
USAGE
}

risk_level="${AGENTSTACK_RISK_LEVEL:-}"
context_file="${AGENTSTACK_CONTEXT_RESULT:-}"
runtime_evidence_file="${AGENTSTACK_RUNTIME_EVIDENCE_RESULT:-}"
pre_submit_review_required="${AGENTSTACK_PRE_SUBMIT_REVIEW_REQUIRED:-no}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --risk-level)
      [ "$#" -ge 2 ] || { echo "agentstack-finish: --risk-level requires a value" >&2; usage >&2; exit 2; }
      risk_level="$2"
      shift 2
      ;;
    --context)
      [ "$#" -ge 2 ] || { echo "agentstack-finish: --context requires a value" >&2; usage >&2; exit 2; }
      context_file="$2"
      shift 2
      ;;
    --runtime-evidence)
      [ "$#" -ge 2 ] || { echo "agentstack-finish: --runtime-evidence requires a value" >&2; usage >&2; exit 2; }
      runtime_evidence_file="$2"
      shift 2
      ;;
    --pre-submit-review-required)
      pre_submit_review_required="yes"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "agentstack-finish: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$risk_level" in ""|L0|L1|L2|L3|L4|L5) ;; *) echo "agentstack-finish: invalid --risk-level: $risk_level" >&2; exit 2 ;; esac
case "$pre_submit_review_required" in yes|no) ;; *) echo "agentstack-finish: invalid AGENTSTACK_PRE_SUBMIT_REVIEW_REQUIRED: $pre_submit_review_required" >&2; exit 2 ;; esac

same_run_file() {
  local rel="$1"
  local path="$out_dir/$rel"
  [ -f "$path" ] && printf '%s\n' "$path"
}

same_run_glob() {
  local pattern="$1"
  find "$out_dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | sort | tail -n 1 || true
}

same_run_glob_all() {
  local pattern="$1"
  find "$out_dir" -maxdepth 1 -type f -name "$pattern" 2>/dev/null | sort || true
}

evidence_run_id() {
  case "$1" in
    .agentstack/evidence/*/*)
      local rest="${1#.agentstack/evidence/}"
      printf '%s\n' "${rest%%/*}"
      ;;
    "$PWD"/.agentstack/evidence/*/*)
      local rest="${1#"$PWD"/.agentstack/evidence/}"
      printf '%s\n' "${rest%%/*}"
      ;;
  esac
}

latest_global() {
  local pattern="$1"
  find .agentstack/evidence -path "$pattern" -type f 2>/dev/null | sort | tail -n 1 || true
}

latest_global_name() {
  local pattern="$1"
  find .agentstack/evidence -type f -name "$pattern" 2>/dev/null | sort | tail -n 1 || true
}

cross_run_warnings=""

resolve_evidence_var() {
  local out_var="$1"
  local explicit="$1"
  explicit="$2"
  local same="$3"
  local global_pattern="$4"
  local label="$5"
  local value=""
  printf -v "${out_var}_cross_run" '%s' "no"
  if [ -n "$explicit" ]; then
    value="$explicit"
    local explicit_run
    explicit_run="$(evidence_run_id "$explicit")"
    if [ -n "$explicit_run" ] && [ "$explicit_run" != "$run_id" ]; then
      cross_run_warnings="${cross_run_warnings}- $label explicitly points to a different run: \`$explicit\`"$'\n'
      printf -v "${out_var}_cross_run" '%s' "yes"
    fi
    printf -v "$out_var" '%s' "$value"
    return 0
  fi
  if [ -n "$same" ]; then
    value="$same"
    printf -v "$out_var" '%s' "$value"
    return 0
  fi
  local global
  global="$(latest_global "$global_pattern")"
  if [ -n "$global" ]; then
    cross_run_warnings="${cross_run_warnings}- $label came from a different run: \`$global\`"$'\n'
    value="$global"
    printf -v "${out_var}_cross_run" '%s' "yes"
  fi
  printf -v "$out_var" '%s' "$value"
}

resolve_evidence_var_two_names() {
  local out_var="$1"
  local explicit="$2"
  local same="$3"
  local global_name_a="$4"
  local global_name_b="$5"
  local label="$6"
  local value=""
  printf -v "${out_var}_cross_run" '%s' "no"
  if [ -n "$explicit" ]; then
    value="$explicit"
    local explicit_run
    explicit_run="$(evidence_run_id "$explicit")"
    if [ -n "$explicit_run" ] && [ "$explicit_run" != "$run_id" ]; then
      cross_run_warnings="${cross_run_warnings}- $label explicitly points to a different run: \`$explicit\`"$'\n'
      printf -v "${out_var}_cross_run" '%s' "yes"
    fi
    printf -v "$out_var" '%s' "$value"
    return 0
  fi
  if [ -n "$same" ]; then
    value="$same"
    printf -v "$out_var" '%s' "$value"
    return 0
  fi
  local global
  global="$(printf '%s\n%s\n' "$(latest_global_name "$global_name_a")" "$(latest_global_name "$global_name_b")" | sed '/^$/d' | sort | tail -n 1)"
  if [ -n "$global" ]; then
    cross_run_warnings="${cross_run_warnings}- $label came from a different run: \`$global\`"$'\n'
    value="$global"
    printf -v "${out_var}_cross_run" '%s' "yes"
  fi
  printf -v "$out_var" '%s' "$value"
}

primary_same_run_review() {
  local default_review
  default_review="$(same_run_file review.md || true)"
  if [ -n "$default_review" ]; then
    printf '%s\n' "$default_review"
    return 0
  fi
  same_run_glob 'review-*.md'
}

same_run_review_has_section() {
  local section="$1"
  local review
  while IFS= read -r review; do
    [ -n "$review" ] || continue
    if section_has_content "$review" "$section"; then
      return 0
    fi
  done <<EOF
$(same_run_glob_all 'review.md')
$(same_run_glob_all 'review-*.md')
EOF
  return 1
}

verify_file=""
review_file=""
dogfood_file=""
handoff_file=""
verify_file_cross_run="no"
review_file_cross_run="no"
dogfood_file_cross_run="no"
handoff_file_cross_run="no"
context_file_cross_run="no"
runtime_evidence_file_cross_run="no"
resolve_evidence_var verify_file "${AGENTSTACK_VERIFY_RESULT:-}" "$(same_run_file verify.json || true)" '*/verify.json' "Verify evidence"
resolve_evidence_var_two_names review_file "${AGENTSTACK_REVIEW_RESULT:-}" "$(primary_same_run_review | tail -n 1)" 'review.md' 'review-*.md' "Review evidence"
resolve_evidence_var dogfood_file "${AGENTSTACK_DOGFOOD_RESULT:-}" "$(same_run_glob 'dogfood-*.md')" '*/dogfood-*.md' "Dogfood evidence"
resolve_evidence_var handoff_file "${AGENTSTACK_HANDOFF_RESULT:-}" "$(same_run_glob 'handoff-*.md')" '*/handoff-*.md' "Handoff evidence"
resolve_evidence_var context_file "$context_file" "$(same_run_file context.md || true)" '*/context.md' "Context evidence"
resolve_evidence_var runtime_evidence_file "$runtime_evidence_file" "$(same_run_file runtime-evidence.md || true)" '*/runtime-evidence.md' "Runtime evidence"

section_has_content() {
  local file="$1"
  local section="$2"
  [ -f "$file" ] || return 1
  awk -v section="$section" '
    $0 == "## " section { in_section=1; next }
    in_section && /^## / { exit }
    in_section && $0 !~ /^[[:space:]]*$/ && $0 !~ /^Not recorded\.$/ { found=1 }
    END { exit found ? 0 : 1 }
  ' "$file"
}

section_first_value() {
  local file="$1"
  local section="$2"
  [ -f "$file" ] || return 1
  awk -v section="$section" '
    $0 == "## " section { in_section=1; next }
    in_section && /^## / { exit }
    in_section {
      line=$0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line != "" && line != "Not recorded.") { print line; found=1; exit }
    }
    END { exit found ? 0 : 1 }
  ' "$file"
}

risk_from_context() {
  local file="$1"
  [ -f "$file" ] || return 1
  awk '
    $0 == "## Risk Level" { in_section=1; next }
    in_section && /^## / { exit }
    in_section {
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", line)
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line ~ /^L[0-5]$/) { print line; found=1; exit }
    }
    END { exit found ? 0 : 1 }
  ' "$file"
}

if [ -z "$risk_level" ] && [ -n "$context_file" ] && [ -f "$context_file" ]; then
  risk_level="$(risk_from_context "$context_file" || true)"
fi
if [ -z "$risk_level" ]; then
  risk_level="L1"
fi

review_files="$(same_run_glob_all 'review.md'; same_run_glob_all 'review-*.md')"
independent_review_file="$(same_run_file review-independent.md || true)"
iteration_files="$(same_run_glob_all 'iteration-*.md')"

warnings=""
add_warning() {
  warnings="${warnings}- $1"$'\n'
}

if [ -z "$verify_file" ] || [ ! -f "$verify_file" ]; then
  add_warning "Verify evidence is missing for risk level $risk_level."
fi

case "$risk_level" in
  L2|L3|L4)
    if [ -z "$context_file" ] || [ ! -f "$context_file" ] || [ "$context_file_cross_run" = "yes" ]; then
      add_warning "$risk_level closure expects context evidence."
    fi
    if [ -z "$review_file" ] || [ ! -f "$review_file" ] || [ "$review_file_cross_run" = "yes" ]; then
      add_warning "$risk_level closure expects review evidence."
    fi
    if { [ "$context_file_cross_run" = "yes" ] || ! section_has_content "$context_file" "Structural Preflight"; } && \
      { [ "$review_file_cross_run" = "yes" ] || ! same_run_review_has_section "Structural Preflight"; }; then
      add_warning "$risk_level closure expects Structural Preflight evidence."
    fi
    ;;
esac

if [ "$risk_level" = "L4" ]; then
  if [ -z "$runtime_evidence_file" ] || [ ! -f "$runtime_evidence_file" ] || [ "$runtime_evidence_file_cross_run" = "yes" ]; then
    add_warning "L4 closure expects real runtime evidence; dogfood and handoff artifacts do not satisfy this gate."
  fi
fi

pre_submit_review_status="not-required"
independent_review_result=""
independent_review_handoff=""
if [ "$pre_submit_review_required" = "yes" ]; then
  pre_submit_review_status="not-recorded"
  if [ -z "$independent_review_file" ] || [ ! -f "$independent_review_file" ]; then
    add_warning "Pre-submit review gate expects independent review evidence."
  else
    independent_review_result="$(section_first_value "$independent_review_file" "Result" || true)"
    independent_review_handoff="$(section_first_value "$independent_review_file" "Handoff" || true)"
    if [ -z "$independent_review_handoff" ]; then
      add_warning "Pre-submit review gate expects independent review handoff evidence."
    fi
    if [ "$independent_review_result" = "pass" ]; then
      pre_submit_review_status="pass"
    else
      pre_submit_review_status="${independent_review_result:-not-recorded}"
      add_warning "Pre-submit review gate expects independent review result pass."
    fi
  fi
elif [ -n "$independent_review_file" ] && [ -f "$independent_review_file" ]; then
  independent_review_result="$(section_first_value "$independent_review_file" "Result" || true)"
  independent_review_handoff="$(section_first_value "$independent_review_file" "Handoff" || true)"
  if [ "$independent_review_result" = "pass" ] && [ -n "$independent_review_handoff" ]; then
    pre_submit_review_status="pass"
  else
    pre_submit_review_status="${independent_review_result:-recorded}"
  fi
fi

{
  echo "# AgentStack Finish Summary"
  echo
  echo "## Run"
  echo "- Run ID: \`$run_id\`"
  echo "- Risk level: \`$risk_level\`"
  echo
  echo "## Changes"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git diff --stat HEAD 2>/dev/null || git diff --stat 2>/dev/null || echo "- No git diff available."
  else
    echo "- No git repository detected."
  fi
  echo
  echo "## Verify"
  if [ -n "$verify_file" ] && [ -f "$verify_file" ]; then
    echo "- Result: \`$verify_file\`"
    grep '"status"' "$verify_file" | sed 's/^/- /' || true
  else
    echo "- No verify result found."
  fi
  echo
  echo "## Context"
  if [ -n "$context_file" ] && [ -f "$context_file" ]; then
    echo "- Result: \`$context_file\`"
    sed -n '1,16p' "$context_file" | sed 's/^/  /'
  else
    echo "- Not recorded."
  fi
  echo
  echo "## Review"
  if [ -n "$review_file" ] && [ -f "$review_file" ]; then
    echo "- Result: \`$review_file\`"
    sed -n '1,36p' "$review_file" | sed 's/^/  /'
  else
    echo "- Not recorded."
  fi
  if [ -n "$review_files" ]; then
    echo
    echo "Same-run review evidence:"
    printf '%s\n' "$review_files" | sed 's/^/- `/' | sed 's/$/`/'
  fi
  echo
  echo "## Pre-Submit Review"
  echo "- Required: $pre_submit_review_required"
  echo "- Independent pre-submit review evidence: $pre_submit_review_status"
  if [ -n "$independent_review_file" ] && [ -f "$independent_review_file" ]; then
    echo "- Result: \`$independent_review_file\`"
  fi
  echo
  echo "## Iterations"
  if [ -n "$iteration_files" ]; then
    printf '%s\n' "$iteration_files" | while IFS= read -r iteration_file; do
      [ -n "$iteration_file" ] || continue
      echo "- Result: \`$iteration_file\`"
      sed -n '1,18p' "$iteration_file" | sed 's/^/  /'
    done
  else
    echo "- Not recorded."
  fi
  echo
  echo "## Dogfood"
  if [ -n "$dogfood_file" ] && [ -f "$dogfood_file" ]; then
    echo "- Result: \`$dogfood_file\`"
    sed -n '1,12p' "$dogfood_file" | sed 's/^/  /'
  else
    echo "- Not recorded."
  fi
  echo
  echo "## Handoff"
  if [ -n "$handoff_file" ] && [ -f "$handoff_file" ]; then
    echo "- Result: \`$handoff_file\`"
    sed -n '1,12p' "$handoff_file" | sed 's/^/  /'
  else
    echo "- Not recorded."
  fi
  echo
  echo "## Runtime Evidence"
  if [ -n "$runtime_evidence_file" ] && [ -f "$runtime_evidence_file" ]; then
    echo "- Result: \`$runtime_evidence_file\`"
    sed -n '1,12p' "$runtime_evidence_file" | sed 's/^/  /'
  else
    echo "- Not recorded."
  fi
  echo
  echo "## Cross-run Evidence Warning"
  if [ -n "$cross_run_warnings" ]; then
    printf '%s' "$cross_run_warnings"
  else
    echo "- None."
  fi
  echo
  echo "## Closure Warnings"
  if [ -n "$warnings" ]; then
    printf '%s' "$warnings"
  else
    echo "- None."
  fi
  echo
  echo "## Risks"
  echo "- Not recorded."
  echo
  echo "## Follow-ups"
  echo "- Not recorded."
} > "$summary"

echo "agentstack-finish: wrote $summary"
