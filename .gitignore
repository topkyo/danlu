
# Add these to your project's .gitignore

# Agent local settings
.claude/*.local.json
.codex/*.local.json
CLAUDE.local.md
AGENTS.local.md
PROGRESS.md

# Harness runtime artifacts (per-sprint, not committed)
.claude/contracts/active.md
.claude/gates/qa-review.md
.claude/gates/qa-runtime.md
.codex/contracts/active.md
.codex/gates/qa-review.md
.codex/gates/qa-runtime.md

# Runtime state and generated outputs
.aiwiki/state/*.json
.aiwiki/logs/*.jsonl
output/

# Harness upgrade staging (generated by upgrade.sh)
.open-harness-upgrade/

# Python
__pycache__/
*.pyc
.venv/
dist/
build/
*.egg-info/
