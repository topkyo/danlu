[Unit]
Description=aiwiki nightly health and repair pass
After=default.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__ENV_FILE__
Environment=PYTHONPATH=__PROJECT_ROOT__/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__PROJECT_ROOT__/scripts/run_nightly.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths="__VAULT__"
RestrictSUIDSGID=true
