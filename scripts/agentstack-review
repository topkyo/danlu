#!/usr/bin/env bash
set -euo pipefail

default_run_id() {
  printf '%s-%s\n' "$(date +%Y%m%d%H%M%S)" "$$"
}

run_id="${AGENTSTACK_RUN_ID:-$(default_run_id)}"
review_id=""
reviewer="inline"
handoff_path=""
scope="Not provided."
findings="No material findings recorded."
risks="Not recorded."
verify="Not recorded."
result=""
risk_level=""
structural_preflight="Not recorded."
context_path=""
include_diff="no"
stdout="no"

usage() {
  cat <<'USAGE'
Usage: agentstack-review [--id ID] [--reviewer inline|independent] [--handoff PATH] [--result pass|needs-fix|blocked] [--risk-level L0|L1|L2|L3|L4|L5] [--scope TEXT] [--findings TEXT] [--risks TEXT] [--verify TEXT] [--structural-preflight TEXT] [--context PATH] [--diff] [--stdout]

Write a standard AgentStack review artifact.
USAGE
}

valid_id() {
  case "$1" in
    ""|*/*|.*|*..*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --id)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --id requires a value" >&2; usage >&2; exit 2; }
      review_id="$2"
      shift 2
      ;;
    --reviewer)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --reviewer requires a value" >&2; usage >&2; exit 2; }
      reviewer="$2"
      case "$reviewer" in inline|independent) ;; *) echo "agentstack-review: invalid --reviewer: $reviewer" >&2; exit 2 ;; esac
      shift 2
      ;;
    --handoff)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --handoff requires a value" >&2; usage >&2; exit 2; }
      handoff_path="$2"
      shift 2
      ;;
    --result)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --result requires a value" >&2; usage >&2; exit 2; }
      result="$2"
      case "$result" in pass|needs-fix|blocked) ;; *) echo "agentstack-review: invalid --result: $result" >&2; exit 2 ;; esac
      shift 2
      ;;
    --risk-level)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --risk-level requires a value" >&2; usage >&2; exit 2; }
      risk_level="$2"
      case "$risk_level" in L0|L1|L2|L3|L4|L5) ;; *) echo "agentstack-review: invalid --risk-level: $risk_level" >&2; exit 2 ;; esac
      shift 2
      ;;
    --scope)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --scope requires a value" >&2; usage >&2; exit 2; }
      scope="$2"
      shift 2
      ;;
    --findings)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --findings requires a value" >&2; usage >&2; exit 2; }
      findings="$2"
      shift 2
      ;;
    --risks)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --risks requires a value" >&2; usage >&2; exit 2; }
      risks="$2"
      shift 2
      ;;
    --verify)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --verify requires a value" >&2; usage >&2; exit 2; }
      verify="$2"
      shift 2
      ;;
    --structural-preflight)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --structural-preflight requires a value" >&2; usage >&2; exit 2; }
      structural_preflight="$2"
      shift 2
      ;;
    --context)
      [ "$#" -ge 2 ] || { echo "agentstack-review: --context requires a value" >&2; usage >&2; exit 2; }
      context_path="$2"
      shift 2
      ;;
    --diff) include_diff="yes"; shift ;;
    --stdout) stdout="yes"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agentstack-review: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -n "$review_id" ]; then
  valid_id "$review_id" || { echo "agentstack-review: invalid --id: $review_id" >&2; exit 2; }
fi
if [ "$reviewer" = "independent" ]; then
  [ -n "$handoff_path" ] || { echo "agentstack-review: independent review requires --handoff" >&2; exit 2; }
  [ -n "$result" ] || { echo "agentstack-review: independent review requires --result" >&2; exit 2; }
fi

out_dir=".agentstack/evidence/$run_id"
mkdir -p "$out_dir"
if [ -n "$review_id" ]; then
  out="$out_dir/review-$review_id.md"
else
  out="$out_dir/review.md"
fi

{
  echo "# AgentStack Review"
  echo
  echo "## Reviewer"
  echo "$reviewer"
  echo
  echo "## Review ID"
  if [ -n "$review_id" ]; then
    echo "$review_id"
  else
    echo "default"
  fi
  echo
  echo "## Handoff"
  if [ -n "$handoff_path" ]; then
    echo "$handoff_path"
  else
    echo "Not recorded."
  fi
  echo
  echo "## Result"
  if [ -n "$result" ]; then
    echo "$result"
  else
    echo "Not recorded."
  fi
  echo
  echo "## Risk Level"
  if [ -n "$risk_level" ]; then
    echo "$risk_level"
  else
    echo "Not recorded."
  fi
  echo
  echo "## Context"
  if [ -n "$context_path" ]; then
    echo "$context_path"
  else
    echo "Not recorded."
  fi
  echo
  echo "## Structural Preflight"
  echo "$structural_preflight"
  echo
  echo "## Scope"
  echo "$scope"
  echo
  echo "## Findings"
  echo "$findings"
  echo
  echo "## Verify"
  echo "$verify"
  echo
  echo "## Risks"
  echo "$risks"
  if [ "$include_diff" = "yes" ]; then
    echo
    echo "## Diff Stat"
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git diff --stat HEAD 2>/dev/null || git diff --stat 2>/dev/null || echo "No diff stat available."
      untracked="$(git ls-files --others --exclude-standard 2>/dev/null || true)"
      if [ -n "$untracked" ]; then
        echo
        echo "## Untracked Files"
        printf '%s\n' "$untracked" | sed 's/^/- /'
      fi
    else
      echo "No git repository detected."
    fi
  fi
} > "$out"

if [ "$stdout" = "yes" ]; then
  cat "$out"
else
  echo "agentstack-review: wrote $out"
fi
