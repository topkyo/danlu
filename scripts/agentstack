#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage: agentstack COMMAND [ARGS]

Commands:
  doctor     Check installation health
  verify     Run targeted verification
  finish     Write finish evidence
  handoff    Generate role handoff evidence
  iteration  Record iteration evidence
  review     Write review evidence
  dogfood    Record dogfood evidence
  version    Print AgentStack version
USAGE
  if can_run agentstack-init || can_run agentstack-render; then
    cat <<'USAGE'

Source commands:
  init       Install AgentStack into a repository
  render     Render adapter files
USAGE
  fi
}

cmd="${1:-}"
if [ -n "$cmd" ]; then
  shift
fi

can_run() {
  local name="$1"
  [ -x "$script_dir/$name" ] || [ -x "$script_dir/../agentstack/scripts/$name" ]
}

run_script() {
  local name="$1"
  shift
  if [ -x "$script_dir/$name" ]; then
    exec "$script_dir/$name" "$@"
  fi
  if [ -x "$script_dir/../agentstack/scripts/$name" ]; then
    exec "$script_dir/../agentstack/scripts/$name" "$@"
  fi
  echo "agentstack: command unavailable in this installation: $name" >&2
  exit 2
}

case "$cmd" in
  init) run_script agentstack-init "$@" ;;
  render) run_script agentstack-render "$@" ;;
  doctor) run_script agentstack-doctor "$@" ;;
  verify) run_script agentstack-verify "$@" ;;
  finish) run_script agentstack-finish "$@" ;;
  handoff) run_script agentstack-handoff "$@" ;;
  iteration) run_script agentstack-iteration "$@" ;;
  review) run_script agentstack-review "$@" ;;
  dogfood) run_script agentstack-dogfood "$@" ;;
  version)
    if [ -f "$script_dir/../VERSION" ]; then
      cat "$script_dir/../VERSION"
    elif [ -f "$script_dir/../agentstack/VERSION" ]; then
      cat "$script_dir/../agentstack/VERSION"
    elif [ -f "$script_dir/../.agentstack/VERSION" ]; then
      cat "$script_dir/../.agentstack/VERSION"
    elif [ -f ".agentstack/VERSION" ]; then
      cat ".agentstack/VERSION"
    else
      echo "unknown"
    fi
    ;;
  ""|-h|--help) usage ;;
  *) echo "agentstack: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
