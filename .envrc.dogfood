# Dogfood receipt 试运行环境
# 启用方式：source .envrc.dogfood
#
# 仅作 dogfood receipt 加速器；runtime 默认值不在此调整。
# STALE_JUDGMENT_DAYS 全局默认仍为 180；P4 计划再做分层化。

# v2 起切到 canonical interactive profile：opencode-api/deepseek-v4-pro primary，
# codex-cli/gpt-5.5 作为显式 fallback；与 runtime 默认和 Product Shell 默认对齐。
# 历史背景：v0/v1 (2026-04-30 / 2026-05-01) 使用 codex-cli/gpt-5.5（详见
# dogfood-receipt-investing-v0.md / v1.md），属于历史 receipt 不再回改。
export AIWIKI_LLM_BACKEND=opencode-api
export AIWIKI_LLM_MODEL=deepseek-v4-pro
export AIWIKI_BACKEND_FALLBACK=codex-cli
export AIWIKI_BACKEND_FALLBACK_MODEL=gpt-5.5
# OpenCode Go 网关（与 OpenCode Zen 不同路径），DeepSeek V4 Pro 走 /zen/go/v1/chat/completions
# 见 https://dev.opencode.ai/docs/go/ ；config.py 默认指向 Zen，需在 dogfood 显式覆盖
export AIWIKI_OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
export AIWIKI_STALE_JUDGMENT_DAYS=1
export PYTHONPATH=src

# F-INV-21: load OpenCode Go API key from chmod 600 secret if available.
# Not all sub-shells inherit AIWIKI_OPENCODE_API_KEY from the outer login shell;
# sourcing the secret file ensures `LLMConfig.from_env()` can resolve the
# opencode-api backend regardless of how the shell was spawned.
# Secret format: AIWIKI_OPENCODE_API_KEY=sk-...
if [ -f "$HOME/.aiwiki-secrets/opencode.env" ]; then
    # shellcheck disable=SC1091
    . "$HOME/.aiwiki-secrets/opencode.env"
    export AIWIKI_OPENCODE_API_KEY
fi

# Dogfood 真实 vault（独立于 ai-wiki 实现仓库）
# CLI 调用必须显式 --root "$AIWIKI_DOGFOOD_VAULT"，否则会误中 ai-wiki 仓库自身的 fixture vault
export AIWIKI_DOGFOOD_VAULT="/home/tim/danlu/炼丹炉"
# Canonical alias used by aiwiki CLI when --root is omitted (P4-11);
# CLI 解析优先级: 显式 --root > AIWIKI_VAULT env > cwd '.'
export AIWIKI_VAULT="$AIWIKI_DOGFOOD_VAULT"
# Receipt 输出位置（vault 内 output/reports/）
export AIWIKI_DOGFOOD_RECEIPT="$AIWIKI_DOGFOOD_VAULT/output/reports/dogfood-receipt-v0.md"
