#!/usr/bin/env bash
set -euo pipefail

platforms="codex,claude,opencode"
source_mode="no"

usage() {
  cat <<'USAGE'
Usage: agentstack-doctor [--platforms codex,claude,opencode,cursor] [--source]

Check an AgentStack source tree or installed target repository.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --platforms)
      if [ "$#" -lt 2 ]; then
        echo "agentstack-doctor: --platforms requires a value" >&2
        usage >&2
        exit 2
      fi
      platforms="$2"
      shift 2
      ;;
    --source) source_mode="yes"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agentstack-doctor: unknown argument: $1" >&2; exit 2 ;;
  esac
done

failures=0

need_file() {
  if [ ! -f "$1" ]; then
    echo "missing file: $1" >&2
    failures=$((failures + 1))
  fi
}

need_exec() {
  if [ ! -x "$1" ]; then
    echo "missing executable: $1" >&2
    failures=$((failures + 1))
  fi
}

need_local_protocol() {
  need_file .agentstack/local/AGENTS.md
}

if [ "$source_mode" = "yes" ]; then
  for file in \
    VERSION \
    core/risk/levels.yaml \
    core/flows/devloop.yaml \
    core/flows/brainstorming.yaml \
    core/flows/write-plan.yaml \
    core/flows/execute-plan.yaml \
    core/flows/finish.yaml \
    core/context/active.md.tpl \
    core/quality/verify.md \
    scripts/agentstack-init \
    scripts/agentstack \
    scripts/agentstack-render \
    scripts/agentstack-verify \
    scripts/agentstack-resolve-verify-targets \
    scripts/agentstack-finish \
    scripts/agentstack-handoff \
    scripts/agentstack-review \
    scripts/agentstack-dogfood; do
    need_file "$file"
  done
else
  need_file .agentstack/VERSION
  need_file .agentstack/install-report.md
  need_exec scripts/agentstack
  need_exec scripts/agentstack-verify
  need_exec scripts/agentstack-resolve-verify-targets
  need_exec scripts/agentstack-finish
  need_exec scripts/agentstack-handoff
  need_exec scripts/agentstack-review
  need_exec scripts/agentstack-dogfood
  [ -d .agentstack ] || { echo "missing directory: .agentstack" >&2; failures=$((failures + 1)); }

  IFS=',' read -r -a platform_array <<< "$platforms"
  for platform in "${platform_array[@]}"; do
    case "$platform" in
      codex)
        need_local_protocol
        need_file .agents/skills/agentstack-devloop/SKILL.md
        need_file .agents/skills/agentstack-brainstorming/SKILL.md
        need_file .agents/skills/agentstack-write-plan/SKILL.md
        need_file .agents/skills/agentstack-execute-plan/SKILL.md
        need_file .agents/skills/agentstack-finish/SKILL.md
        ;;
      claude)
        need_file CLAUDE.md
        need_file .claude/skills/devloop/SKILL.md
        need_file .claude/skills/brainstorming/SKILL.md
        need_file .claude/skills/write-plan/SKILL.md
        need_file .claude/skills/execute-plan/SKILL.md
        need_file .claude/skills/finish/SKILL.md
        ;;
      opencode)
        need_local_protocol
        need_file .opencode/skills/devloop/SKILL.md
        need_file .opencode/skills/brainstorming/SKILL.md
        need_file .opencode/skills/write-plan/SKILL.md
        need_file .opencode/skills/execute-plan/SKILL.md
        need_file .opencode/skills/finish/SKILL.md
        need_file .opencode/agents/explorer.md
        need_file .opencode/agents/reviewer.md
        ;;
      cursor)
        need_file .cursor/rules/agentstack.mdc
        ;;
      "")
        ;;
      *)
        echo "unknown platform: $platform" >&2
        failures=$((failures + 1))
        ;;
    esac
  done
fi

if [ "$failures" -gt 0 ]; then
  echo "agentstack-doctor: failed with $failures issue(s)" >&2
  exit 1
fi

echo "agentstack-doctor: ok"
