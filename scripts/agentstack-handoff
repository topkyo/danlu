#!/usr/bin/env bash
set -euo pipefail

default_run_id() {
  printf '%s-%s\n' "$(date +%Y%m%d%H%M%S)" "$$"
}

run_id="${AGENTSTACK_RUN_ID:-$(default_run_id)}"
role=""
task=""
scope=""
context=""
files=""
commands=""
constraints=""
side_effect_level=""
stdout="no"

usage() {
  cat <<'USAGE'
Usage: agentstack-handoff --role ROLE --task TEXT --scope TEXT [options]

Generate an AgentStack role handoff artifact.

Options:
  --context TEXT
  --files TEXT
  --commands TEXT
  --constraints TEXT
  --side-effect-level read-only|command-only|scoped-write|external-side-effect
  --stdout

Roles: explorer, implementer, reviewer, shell-runner, debugger
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --role)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --role requires a value" >&2; usage >&2; exit 2; }
      role="$2"
      shift 2
      ;;
    --task)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --task requires a value" >&2; usage >&2; exit 2; }
      task="$2"
      shift 2
      ;;
    --scope)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --scope requires a value" >&2; usage >&2; exit 2; }
      scope="$2"
      shift 2
      ;;
    --context)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --context requires a value" >&2; usage >&2; exit 2; }
      context="$2"
      shift 2
      ;;
    --files)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --files requires a value" >&2; usage >&2; exit 2; }
      files="$2"
      shift 2
      ;;
    --commands)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --commands requires a value" >&2; usage >&2; exit 2; }
      commands="$2"
      shift 2
      ;;
    --constraints)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --constraints requires a value" >&2; usage >&2; exit 2; }
      constraints="$2"
      shift 2
      ;;
    --side-effect-level)
      [ "$#" -ge 2 ] || { echo "agentstack-handoff: --side-effect-level requires a value" >&2; usage >&2; exit 2; }
      side_effect_level="$2"
      shift 2
      ;;
    --stdout) stdout="yes"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agentstack-handoff: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$role" in
  explorer|implementer|reviewer|shell-runner|debugger) ;;
  "") echo "agentstack-handoff: --role is required" >&2; usage >&2; exit 2 ;;
  *) echo "agentstack-handoff: unknown role: $role" >&2; exit 2 ;;
esac

[ -n "$task" ] || { echo "agentstack-handoff: --task is required" >&2; exit 2; }
[ -n "$scope" ] || { echo "agentstack-handoff: --scope is required" >&2; exit 2; }

if [ -z "$side_effect_level" ]; then
  case "$role" in
    explorer|reviewer) side_effect_level="read-only" ;;
    shell-runner) side_effect_level="command-only" ;;
    implementer|debugger) side_effect_level="scoped-write" ;;
  esac
fi

case "$side_effect_level" in
  read-only|command-only|scoped-write|external-side-effect) ;;
  *) echo "agentstack-handoff: invalid side-effect level: $side_effect_level" >&2; exit 2 ;;
esac

output_format() {
  case "$role" in
    explorer)
      echo "Relevant files, entrypoints, local instructions, verify commands, risks."
      ;;
    implementer)
      echo "Changes made, files changed, verification result, issues for parent."
      ;;
    reviewer)
      echo "Findings by severity with file references, open questions, residual risk."
      ;;
    shell-runner)
      echo "Command, exit status, short relevant logs, failure summary."
      ;;
    debugger)
      echo "Symptom, reproduction, root cause, minimal fix, verification result."
      ;;
  esac
}

out_dir=".agentstack/evidence/$run_id"
mkdir -p "$out_dir"
out="$out_dir/handoff-$role.md"

{
  echo "# AgentStack Handoff: $role"
  echo
  echo "## Role"
  echo "- Role: $role"
  echo "- Side effect level: $side_effect_level"
  echo
  echo "## Task"
  echo "$task"
  echo
  echo "## Scope"
  echo "$scope"
  echo
  echo "## Context"
  if [ -n "$context" ]; then
    echo "$context"
  else
    echo "- Not provided."
  fi
  echo
  echo "## Files"
  if [ -n "$files" ]; then
    echo "$files"
  else
    echo "- Not provided."
  fi
  echo
  echo "## Commands"
  if [ -n "$commands" ]; then
    echo "$commands"
  else
    echo "- Not provided."
  fi
  echo
  echo "## Constraints"
  if [ -n "$constraints" ]; then
    echo "$constraints"
  else
    echo "- Follow AgentStack role permissions."
  fi
  echo
  echo "## Output Format"
  echo "$(output_format)"
} > "$out"

if [ "$stdout" = "yes" ]; then
  cat "$out"
else
  echo "agentstack-handoff: wrote $out"
fi
