#!/usr/bin/env bash
set -euo pipefail

default_run_id() {
  printf '%s-%s\n' "$(date +%Y%m%d%H%M%S)" "$$"
}

run_id="${AGENTSTACK_RUN_ID:-$(default_run_id)}"
iteration_id=""
trigger=""
input_path=""
action=""
verify="Not recorded."
result=""
stdout="no"

usage() {
  cat <<'USAGE'
Usage: agentstack-iteration --id ID --trigger verify|review|runtime|manual --action TEXT --result pass|fail|needs-review|blocked [--input PATH] [--verify TEXT] [--stdout]

Record an AgentStack iteration attempt. This writes evidence only; it does not run fixes or spawn agents.
USAGE
}

valid_id() {
  case "$1" in
    ""|*/*|.*|*..*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --id)
      [ "$#" -ge 2 ] || { echo "agentstack-iteration: --id requires a value" >&2; usage >&2; exit 2; }
      iteration_id="$2"
      shift 2
      ;;
    --trigger)
      [ "$#" -ge 2 ] || { echo "agentstack-iteration: --trigger requires a value" >&2; usage >&2; exit 2; }
      trigger="$2"
      case "$trigger" in verify|review|runtime|manual) ;; *) echo "agentstack-iteration: invalid --trigger: $trigger" >&2; exit 2 ;; esac
      shift 2
      ;;
    --input)
      [ "$#" -ge 2 ] || { echo "agentstack-iteration: --input requires a value" >&2; usage >&2; exit 2; }
      input_path="$2"
      shift 2
      ;;
    --action)
      [ "$#" -ge 2 ] || { echo "agentstack-iteration: --action requires a value" >&2; usage >&2; exit 2; }
      action="$2"
      shift 2
      ;;
    --verify)
      [ "$#" -ge 2 ] || { echo "agentstack-iteration: --verify requires a value" >&2; usage >&2; exit 2; }
      verify="$2"
      shift 2
      ;;
    --result)
      [ "$#" -ge 2 ] || { echo "agentstack-iteration: --result requires a value" >&2; usage >&2; exit 2; }
      result="$2"
      case "$result" in pass|fail|needs-review|blocked) ;; *) echo "agentstack-iteration: invalid --result: $result" >&2; exit 2 ;; esac
      shift 2
      ;;
    --stdout) stdout="yes"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agentstack-iteration: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$iteration_id" ] || { echo "agentstack-iteration: --id is required" >&2; usage >&2; exit 2; }
valid_id "$iteration_id" || { echo "agentstack-iteration: invalid --id: $iteration_id" >&2; exit 2; }
[ -n "$trigger" ] || { echo "agentstack-iteration: --trigger is required" >&2; usage >&2; exit 2; }
[ -n "$action" ] || { echo "agentstack-iteration: --action is required" >&2; usage >&2; exit 2; }
[ -n "$result" ] || { echo "agentstack-iteration: --result is required" >&2; usage >&2; exit 2; }

out_dir=".agentstack/evidence/$run_id"
mkdir -p "$out_dir"
out="$out_dir/iteration-$iteration_id.md"

{
  echo "# AgentStack Iteration: $iteration_id"
  echo
  echo "## Trigger"
  echo "$trigger"
  echo
  echo "## Input"
  if [ -n "$input_path" ]; then
    echo "$input_path"
  else
    echo "Not recorded."
  fi
  echo
  echo "## Action"
  echo "$action"
  echo
  echo "## Verify"
  echo "$verify"
  echo
  echo "## Result"
  echo "$result"
} > "$out"

if [ "$stdout" = "yes" ]; then
  cat "$out"
else
  echo "agentstack-iteration: wrote $out"
fi
