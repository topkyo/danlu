
# Add these to your project's .gitignore

# Agent local settings
.claude/*.local.json
.codex/*.local.json
CLAUDE.local.md
AGENTS.local.md
PROGRESS.md

# Local secrets and environment overrides
.env
.env.*
.envrc
.envrc.*
!.env.example

# AgentStack local state
.agentstack/evidence/
.agentstack/local/
.agentstack/render-conflicts/
.codegraph/

# Runtime state and generated outputs
.aiwiki/state/*.json
.aiwiki/state/*.jsonl
.aiwiki/state/runtime.lock
.aiwiki/cache.db
.aiwiki/cache.db-wal
.aiwiki/cache.db-shm
.aiwiki/cache/
.aiwiki/logs/*.jsonl
.aiwiki/llm-responses/
output/
!tests/fixtures/acceptance/M6.1b/case_heavy_after_llm/root/output/
!tests/fixtures/acceptance/M6.1b/case_heavy_after_llm/root/output/_candidates/
!tests/fixtures/acceptance/M6.1b/case_heavy_after_llm/root/output/_candidates/elixirs/
!tests/fixtures/acceptance/M6.1b/case_heavy_after_llm/root/output/_candidates/elixirs/elixir-b3.md

# Python
__pycache__/
*.pyc
*.swp
.venv/
dist/
build/
*.egg-info/
.coverage

# Obsidian user-local (themes, community plugin list, plugin runtime state)
.obsidian/community-plugins.json
.obsidian/themes/
.obsidian/plugins/*/data.json

# Plugin dev scaffolding (rebuild via `npm install` + jest; not for redistribution)
.obsidian/plugins/*/node_modules/
.obsidian/plugins/*/package.json
.obsidian/plugins/*/package-lock.json
.obsidian/plugins/*/__mocks__/

# Probe/scratch files
probe_*.md

# Local design reference material (embedded git repo, not for redistribution)
awesome-design-md/
