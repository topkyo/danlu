
# Add these to your project's .gitignore

# Agent local settings
.claude/*.local.json
.codex/*.local.json
CLAUDE.local.md
AGENTS.local.md
PROGRESS.md

# Local secrets and environment overrides
.env
.env.*
.envrc
.envrc.*
!.env.example
!.envrc.dogfood

# Local harness scaffold (generated from /home/tim/open-harness, not committed)
.claude/
.codex/
.copilot/
.opencode/
.open-harness-tier
.open-harness.conf
.open-harness-upgrade/
scripts/apply_calibration_recommendation.sh
scripts/calibration_report.sh
scripts/closed_loop.sh
scripts/deploy_gate.sh
scripts/deploy_with_gate.sh
scripts/enforce_closed_loop_policy.sh
scripts/finalize_task.sh
scripts/launch_qa_review.sh
scripts/resolve_review_mode.sh
scripts/run_qa_review.sh
scripts/write_calibration_entry.sh
scripts/write_gate_artifact.sh
scripts/materialize_contract.sh
scripts/opencode_review_launcher.sh
scripts/run_plan.sh
scripts/lib/
scripts/platforms/

# Runtime state and generated outputs
.aiwiki/state/*.json
.aiwiki/state/*.jsonl
.aiwiki/state/runtime.lock
.aiwiki/cache.db
.aiwiki/cache.db-wal
.aiwiki/cache.db-shm
.aiwiki/cache/
.aiwiki/logs/*.jsonl
.aiwiki/llm-responses/
output/

# Python
__pycache__/
*.pyc
*.swp
.venv/
dist/
build/
*.egg-info/
.coverage

# Obsidian user-local (themes, community plugin list, plugin runtime state)
.obsidian/community-plugins.json
.obsidian/themes/
.obsidian/plugins/*/data.json

# Plugin dev scaffolding (rebuild via `npm install` + jest; not for redistribution)
.obsidian/plugins/*/node_modules/
.obsidian/plugins/*/package.json
.obsidian/plugins/*/package-lock.json
.obsidian/plugins/*/__mocks__/

# Probe/scratch files
probe_*.md

# Local design reference material (embedded git repo, not for redistribution)
awesome-design-md/
