#!/usr/bin/env bash
set -euo pipefail

json="no"
full="no"

usage() {
  cat <<'USAGE'
Usage: agentstack-resolve-verify-targets [--json] [--full]

Print verification targets, one per line. With --json, print {"targets":[...]}.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) json="yes"; shift ;;
    --full) full="yes"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "agentstack-resolve-verify-targets: unknown argument: $1" >&2; exit 2 ;;
  esac
done

print_targets() {
  if [ "$json" = "yes" ]; then
    local first="yes"
    printf '{"targets":['
    while IFS= read -r target; do
      [ -n "$target" ] || continue
      if [ "$first" = "no" ]; then printf ','; fi
      first="no"
      printf '"%s"' "$target"
    done
    printf ']}\n'
  else
    cat
  fi
}

if [ "$full" = "yes" ]; then
  printf 'all\n' | print_targets
  exit 0
fi

if [ -x scripts/verify_target_rules.sh ]; then
  scripts/verify_target_rules.sh | awk 'NF' | sort -u | print_targets
  exit 0
fi

changed_files() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git rev-parse --verify HEAD >/dev/null 2>&1; then
      git diff --name-only HEAD -- || true
      git diff --name-only --cached -- || true
    fi
    git ls-files --others --exclude-standard || true
  else
    find . -type f \
      ! -path './.git/*' \
      ! -path './.agentstack/*' \
      ! -path './node_modules/*' \
      ! -path './dist/*' \
      ! -path './build/*' | sed 's#^\./##'
  fi
}

files="$(changed_files | awk 'NF' | sort -u)"

if [ -z "$files" ]; then
  printf 'smoke\n' | print_targets
  exit 0
fi

{
  printf '%s\n' "$files" | grep -E '(^|/)scripts/|\.sh$' >/dev/null && echo scripts
  printf '%s\n' "$files" | grep -E '(^|/)package\.json$|\.([cm]?js|tsx?|jsx)$' >/dev/null && echo node
  printf '%s\n' "$files" | grep -E '(^|/)(pyproject\.toml|setup\.py|requirements\.txt)$|\.py$' >/dev/null && echo python
  printf '%s\n' "$files" | grep -E '(^|/)go\.mod$|\.go$' >/dev/null && echo go
  printf '%s\n' "$files" | grep -E '(^|/)Cargo\.toml$|\.rs$' >/dev/null && echo rust
  printf '%s\n' "$files" | grep -E '\.md$|(^|/)docs/' >/dev/null && echo docs
} | awk 'NF' | sort -u | {
  read -r first || true
  if [ -z "${first:-}" ]; then
    echo smoke
  else
    echo "$first"
    cat
  fi
} | print_targets

